          "op": "and",
          "args": [
            {
              "op": "not_equal",
              "args": [
                {
                  "op": "field",
                  "field": "scale"
                },
                {
                  "op": "literal",
                  "value": "bps"
                }
              ]
            },
            {
              "op": "greater_than_or_equal",
              "args": [
                {
                  "op": "field",
                  "field": "score"
                },
                {
                  "op": "literal",
                  "value": 4
                }
              ]
            },
            {
              "op": "less_than_or_equal",
              "args": [
                {
                  "op": "field",
                  "field": "score"
                },
                {
                  "op": "literal",
                  "value": 6
                }
              ]
            }
          ]
        },
        "label": "Moderate Pain",
        "description": "Score 4–6.",
        "severity": "warning",
        "recommendations": [
          "Assess and manage according to the approved pain protocol."
        ],
        "order": 5
      },
      {
        "key": "severe_pain",
        "when": {
          "op": "and",
          "args": [
            {
              "op": "not_equal",
              "args": [
                {
                  "op": "field",
                  "field": "scale"
                },
                {
                  "op": "literal",
                  "value": "bps"
                }
              ]
            },
            {
              "op": "greater_than_or_equal",
              "args": [
                {
                  "op": "field",
                  "field": "score"
                },
                {
                  "op": "literal",
                  "value": 7
                }
              ]
            }
