          "op": "and",
          "args": [
            {
              "op": "not_equal",
              "args": [
                {
                  "op": "field",
                  "field": "scale"
                },
                {
                  "op": "literal",
                  "value": "bps"
                }
              ]
            },
            {
              "op": "equal",
              "args": [
                {
                  "op": "field",
                  "field": "score"
                },
                {
                  "op": "literal",
                  "value": 0
