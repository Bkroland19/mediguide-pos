# syntax=docker/dockerfile:1.7

FROM node:22.18.0-alpine3.22 AS dependencies

WORKDIR /app
COPY guidelines-platform/package.json guidelines-platform/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

FROM dependencies AS build

COPY guidelines-platform/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.29.4-alpine AS runtime

ARG BUILD_VERSION=development
ARG BUILD_REVISION=unknown

LABEL org.opencontainers.image.title="MediGuide Clinical Guidelines" \
      org.opencontainers.image.description="Public MediGuide clinical guidelines platform" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.opencontainers.image.revision="${BUILD_REVISION}"

COPY guidelines-platform/nginx.conf /etc/nginx/conf.d/default.conf
COPY guidelines-platform/docker/runtime-config.js.template /etc/clinical-guidelines/runtime-config.js.template
COPY --chmod=755 guidelines-platform/docker/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --from=build /app/dist /usr/share/nginx/html

ENV MEDIGUIDE_POS_URL=http://localhost:3000 \
    MEDIGUIDE_API_URL=http://localhost:8080

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
