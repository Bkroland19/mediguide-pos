# Safe local-development defaults used by `make up`.
APP_ENV=development
REDIS_KEY_PREFIX=mediguide:development
REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=noeviction
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_READ_TIMEOUT_MS=1000
REDIS_WRITE_TIMEOUT_MS=1000
RATE_LIMIT_ENABLED=true
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_ITEM_BYTES=1048576
TRUSTED_PROXIES=

API_IMAGE=mediguide-api:development
AI_WORKER_IMAGE=mediguide-ai-worker:development
DASHBOARD_IMAGE=mediguide-dashboard:development

POSTGRES_DB=mediguide
POSTGRES_USER=mediguide
POSTGRES_PASSWORD=mediguide
POSTGRES_PUBLIC_PORT=5433

MINIO_ROOT_USER=mediguide
MINIO_ROOT_PASSWORD=mediguide123
MINIO_PUBLIC_PORT=9000
MINIO_CONSOLE_PUBLIC_PORT=9001

API_PUBLIC_PORT=8080
PUBLIC_API_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DASHBOARD_PUBLIC_PORT=3000
DASHBOARD_PUBLIC_URL=http://localhost:3000

# Set to `development` to log accepted email messages locally.
MAIL_DRIVER=disabled
MAIL_FROM=development@mediguide.local

GUIDELINES_PUBLIC_PORT=5173
GUIDELINES_DEV_IMAGE=mediguide-guidelines:development
CHOKIDAR_USEPOLLING=true
